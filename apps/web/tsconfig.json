{
	"extends": "@fiscalcheck/tsconfig/nextjs.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"],
			"@fiscalcheck/shared-types": ["../../packages/shared-types/src/index.ts"]
		},
		"plugins": [{ "name": "next" }]
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".next", "dist", "coverage"]
}
