{
  "name": "@fiscalcheck/web",
  "version": "0.1.0",
  "private": true,
  "description": "FiscalCheck AI — Frontend Next.js do auditor fiscal",
  "scripts": {
    "dev": "next dev --turbo -H 0.0.0.0",
    "build": "next build",
