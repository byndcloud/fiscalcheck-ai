    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "msw": "^2.14.6",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.1.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
