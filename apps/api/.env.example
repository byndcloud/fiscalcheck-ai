# apps/api — variáveis específicas do backend FastAPI

ENVIRONMENT=development
LOG_LEVEL=INFO

# Banco PostgreSQL (com pgvector; AGE opt-in via docker-compose — ver ADR-0002)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fiscocheck
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5432/fiscocheck
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/fiscocheck_test

# Cache / fila
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14

# CORS (origens permitidas, separadas por vírgula)
CORS_ALLOW_ORIGINS=http://localhost:3000

# LGPD / pseudonimização
PSEUDONYMIZATION_SALT=change-me-distinct-from-jwt-secret
AUDIT_LOG_RETENTION_DAYS=1825

# IA / LLMs (módulos 3 e 7)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fiscocheck-ai-dev
LANGSMITH_TRACING=false

# Observabilidade (placeholder)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
