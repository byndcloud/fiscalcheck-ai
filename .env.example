# ============================================================
# FiscalCheck AI — Variáveis de ambiente (raiz)
# ============================================================
# Copie para .env e ajuste conforme seu ambiente.
# NUNCA commitar .env real (contém segredos).
# Cada app (apps/web, apps/api) tem seu próprio .env.example
# com o subset apropriado.
# ============================================================

NODE_ENV=development

# ------------------------------------------------------------
# Banco de dados (PostgreSQL 16+ com pgvector; AGE opt-in via docker-compose — ver ADR-0002)
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fiscalcheck
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/fiscalcheck_test

# ------------------------------------------------------------
# Cache / fila (Redis 7+)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# Segredos de autenticação
# Gere com: openssl rand -hex 32
# ------------------------------------------------------------
JWT_SECRET=change-me-use-openssl-rand-hex-32
NEXTAUTH_SECRET=change-me-use-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# Comunicação entre apps
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------
# IA / LLMs (módulos 3 e 7)
# ------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fiscalcheck-ai-dev
LANGSMITH_TRACING=false

# ------------------------------------------------------------
# Observabilidade (placeholder)
# ------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------
# Notificações ao contribuinte (módulo 4 — definir provedores)
# ------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# ------------------------------------------------------------
# LGPD / Conformidade
# ------------------------------------------------------------
PSEUDONYMIZATION_SALT=change-me-distinct-from-jwt-secret
AUDIT_LOG_RETENTION_DAYS=1825
