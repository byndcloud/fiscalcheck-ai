{
	"name": "fiscalcheck-ai",
	"version": "0.1.0",
	"private": true,
	"description": "FiscalCheck AI — Plataforma de Inteligência Fiscal Agêntica (Brusque/SC)",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=9.0.0"
	},
	"packageManager": "pnpm@11.10.0",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"lint": "pnpm -r lint",
		"lint:fix": "pnpm -r lint:fix",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"format": "pnpm -r format",
		"format:check": "pnpm -r format:check",
		"api:dev": "pnpm --filter @fiscalcheck/api dev",
		"web:dev": "pnpm --filter @fiscalcheck/web dev"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"typescript": "^5.7.2"
	}
}
