run = "pnpm dev"
entrypoint = "README.md"
modules = ["nodejs-22", "python-3.12", "postgresql-16"]

hidden = [".pnpm-store", "node_modules", ".venv", ".uv", ".next", "dist", "__pycache__"]

[nix]
channel = "stable-24_05"

# Deploy: Replit Deployments destina-se ao piloto/demo. Produção real
# vai para nuvem nacional (AWS São Paulo / Azure Brazil South / nuvem
# TCE-SC) — ver ADR-0001. O deploy roda build de produção (Next.js
# `next start` + uvicorn sem --reload), nunca os dev servers.
[deployment]
build = ["sh", "-c", "pnpm install --frozen-lockfile && pnpm build && cd apps/api && uv sync --frozen"]
run = ["sh", "-c", "pnpm -r --parallel start"]
deploymentTarget = "cloudrun"
ignorePorts = false

[env]
PYTHONUNBUFFERED = "1"
PNPM_HOME = "/home/runner/.local/share/pnpm"
PATH = "$PNPM_HOME:$PATH"

[workflows]
runButton = "Dev (web + api)"

  [[workflows.workflow]]
  name = "Dev (web + api)"
  mode = "parallel"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm --filter @fiscalcheck/web dev"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm --filter @fiscalcheck/api dev"

  [[workflows.workflow]]
  name = "API only"
  mode = "sequential"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm --filter @fiscalcheck/api dev"

  [[workflows.workflow]]
  name = "Web only"
  mode = "sequential"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm --filter @fiscalcheck/web dev"

  [[workflows.workflow]]
  name = "Tests (all)"
  mode = "sequential"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm test"

  [[workflows.workflow]]
  name = "DB migrate"
  mode = "sequential"

    [[workflows.workflow.tasks]]
    task = "shell.exec"
    args = "pnpm --filter @fiscalcheck/api migrate"

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 23345
externalPort = 3000

[agent]
expertMode = true
